# Base de test dedicada (misma instancia de docker/compose.dev.yml, otra
# base de datos) — nunca se toca la base de desarrollo desde los tests.
DATABASE_URL=postgres://eike:eike_local@localhost:5433/eike_test
SESSION_SECRET=secreto-de-test-de-al-menos-32-caracteres-no-usar-en-prod
UPLOADS_DIR=./.data/uploads-test
# Los tests de concurrencia del carrito (Fase 6) abren varias transacciones
# simultáneas de verdad — con el default de prod (8) el pool se agota antes
# de terminar. Solo acá, no afecta a prod (ver db/cliente.ts).
DB_POOL_MAX=20
