# Copiar a .env (nunca se commitea) y completar con valores reales.

# --- Base de datos (Postgres local vía docker/compose.dev.yml) ---
DATABASE_URL=postgres://eike:eike_local@localhost:5463/eike
# Máximo de conexiones del pool. Opcional (default 8) — .env.test lo sube a
# 20 para los tests de concurrencia del carrito; no hace falta tocarlo acá.
# DB_POOL_MAX=8

# --- Sesión (iron-session) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres

# COOKIE_SECURE=true recién en la Fase 10 (cutover), cuando Caddy sirva con
# HTTPS real. En local y en la Fase 7 (pruebas por IP sin dominio) se deja
# sin definir/false — una cookie "Secure" se descarta en HTTP plano.
COOKIE_SECURE=false

# --- Uploads (Fase 2+) ---
UPLOADS_DIR=./.data/uploads

# --- URL pública (SEO, metadata, links de invitación) ---
SITE_URL=http://localhost:3000

# --- Barrido de reservas vencidas (Fase 3) ---
# Protege POST /api/mantenimiento/barrer. Sin este valor el endpoint queda
# deshabilitado (responde 503), no abierto sin auth.
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MANTENIMIENTO_TOKEN=cambiar-por-un-token-de-servicio

# --- Origen de la migración de datos (scripts/migrar-mariadb.ts, Fase 3) ---
# Contra el docker-compose del proyecto PHP viejo (ticketapi): puerto 3307 en
# el host. Contra producción real (holasa_eike): ver plan de migración §7.2
# (Remote MySQL habilitado en Webuzo, o el Plan B de exportar por phpMyAdmin
# e importar a una MariaDB local efímera).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=eike
MYSQL_PASSWORD=eike_local
MYSQL_DATABASE=eike

# --- Carpeta de uploads del sistema PHP viejo, para la validación #9 del
# script de migración (existencia de afiches/comprobantes referenciados).
# Vacío = se omite esa validación con una advertencia. ---
UPLOADS_DIR_ORIGEN=

# Conciliación de pagos (aviso del banco por IMAP + comprobante por WhatsApp)
IMAP_HOST=hostingparaguay.cloud
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Correo al comprador cuando se aprueba/rechaza su compra. Sale por la MISMA
# cuenta de arriba (IMAP_USER/IMAP_PASS); estas solo hacen falta si el servidor
# de salida es otro. Fuera de producción no se envía nada salvo CORREO_ENVIO_DEV=true.
# OJO: el SMTP de hostingparaguay.cloud tiene un certificado autofirmado y vencido;
# usá mail.eikepy.com, que sí tiene certificado válido.
SMTP_HOST=mail.eikepy.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CORREO_ENVIO_DEV=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# "true" = envía de verdad por la Cloud API; vacío = simula (solo registra en mensajes_whatsapp).
WHATSAPP_ENVIO_ACTIVO=
# Asistente con Gemini (usar SIEMPRE el tier de pago: el gratuito entrena con los datos).
# "true" + GEMINI_API_KEY = contesta las preguntas; vacío = solo la guía fija y la derivación a una persona.
CHATBOT_ACTIVO=
GEMINI_API_KEY=
GEMINI_MODEL=
OCR_API_KEY=
# Remitentes del banco aceptados (dominios o direcciones, separados por coma).
# "*" acepta cualquiera: solo para probar con correos reenviados desde Gmail (se ignora en producción).
CONCILIACION_REMITENTES=itau.com.py,familiar.com.py,ueno.com.py
CONCILIACION_EXIGIR_DKIM=false
# Cuentas propias que reciben los pagos, separadas por coma (solo dígitos; los ceros a la
# izquierda no importan). Un aviso de Itaú a otra cuenta se descarta. OBLIGATORIO en producción
# para tener esta defensa: sin esta variable no se verifica la cuenta. Familiar y UENO no
# informan la cuenta destino, así que con esos bancos no aplica.
CONCILIACION_CUENTAS=
# Opcional: texto que debe contener el beneficiario del comprobante (nombre
# del titular de la cuenta de Eike) para pasar el pre-check.
CONCILIACION_BENEFICIARIO=
WHATSAPP_WABA_ID=
# Opcional: servidores DNS para buscar las claves DKIM del banco (por defecto, los del sistema).
CONCILIACION_DNS_SERVERS=
