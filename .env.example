# Copiar a .env (nunca se commitea) y completar con valores reales.

# --- Base de datos (Postgres local vía docker/compose.dev.yml) ---
DATABASE_URL=postgres://eike:eike_local@localhost:5433/eike

# --- Sesión (iron-session) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres

# --- Uploads (Fase 2+) ---
UPLOADS_DIR=./.data/uploads

# --- URL pública (SEO, metadata, links de invitación) ---
SITE_URL=http://localhost:3000

# --- Origen de la migración de datos (scripts/migrar-mariadb.ts, Fase 3) ---
# Contra el docker-compose del proyecto PHP viejo (ticketapi): puerto 3307 en
# el host. Contra producción real (holasa_eike): ver plan de migración §7.2
# (Remote MySQL habilitado en Webuzo, o el Plan B de exportar por phpMyAdmin
# e importar a una MariaDB local efímera).
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=eike
MYSQL_PASSWORD=eike_local
MYSQL_DATABASE=eike

# --- Carpeta de uploads del sistema PHP viejo, para la validación #9 del
# script de migración (existencia de afiches/comprobantes referenciados).
# Vacío = se omite esa validación con una advertencia. ---
UPLOADS_DIR_ORIGEN=
